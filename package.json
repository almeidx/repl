{
	"name": "repl",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prebuild": "svelte-kit sync",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "pnpm build && wrangler deploy",
		"dev": "vite dev",
		"fmt": "oxfmt && oxlint --fix --ignore-pattern '**/*.svelte'",
		"lint": "oxfmt --check && oxlint --deny-warnings --ignore-pattern '**/*.svelte'",
		"preview": "wrangler dev",
		"test": "pnpm test:unit",
		"test:ci": "pnpm test:unit",
		"test:e2e": "pnpm test:smoke",
		"test:smoke": "playwright test --config=playwright.config.ts",
		"test:unit": "vitest run tests/unit"
	},
	"dependencies": {
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"@zag-js/collection": "^1.35.2",
		"@zag-js/combobox": "^1.35.2",
		"@zag-js/dialog": "^1.35.2",
		"@zag-js/dom-query": "^1.35.2",
		"@zag-js/svelte": "^1.35.2",
		"@zag-js/tree-view": "^1.35.2",
		"monaco-editor": "^0.55.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.53.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.1",
		"@types/node": "^25.3.2",
		"@webcontainer/api": "^1.6.1",
		"oxfmt": "^0.35.0",
		"oxlint": "^1.50.0",
		"svelte": "^5.53.6",
		"svelte-check": "^4.4.4",
		"tailwindcss": "^4.2.1",
		"typescript": "~5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"wrangler": "^4.69.0"
	},
	"packageManager": "pnpm@10.30.3"
}
